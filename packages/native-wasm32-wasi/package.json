{
  "name": "@stax-xml/native-wasm32-wasi",
  "version": "1.0.0-rc2",
  "description": "WASI WebAssembly acceleration package for stax-xml.",
  "license": "MIT",
  "type": "module",
  "main": "./stax_xml_native.wasi.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "browser": "./stax_xml_native.wasi-browser.js",
      "import": "./index.mjs",
      "require": "./stax_xml_native.wasi.cjs",
      "default": "./index.mjs"
    },
    "./stax_xml_native.wasm32-wasi.wasm": "./stax_xml_native.wasm32-wasi.wasm"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "stax_xml_native.wasi.cjs",
    "stax_xml_native.wasi-browser.js",
    "stax_xml_native.wasm32-wasi.wasm",
    "wasi-worker.mjs",
    "wasi-worker-browser.mjs",
    "README.md",
    "LICENSE"
  ],
  "cpu": [
    "wasm32"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.10.0",
    "@napi-rs/wasm-runtime": "1.1.4"
  },
  "napi": {
    "binaryName": "stax_xml_native",
    "targets": [
      "wasm32-wasip1-threads"
    ],
    "wasm": {
      "browser": {
        "asyncInit": true
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
