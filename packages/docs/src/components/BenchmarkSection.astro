---
import latestSummary from '../../../benchmark/results/release/latest-summary.json';

type Locale = 'en' | 'ko';
type Section =
  | 'environment'
  | 'parser-2kb'
  | 'parser-4kb'
  | 'npm-xml-parsers'
  | 'parser-13mb'
  | 'parser-98mb'
  | 'async-size'
  | 'converter'
  | 'writer-small'
  | 'writer-big'
  | 'writer-async'
  | 'writer-1gb';

interface Props {
  locale: Locale;
  section: Section;
  version?: string;
}

const { locale, section, version } = Astro.props as Props;

const benchmarkSnapshots = import.meta.glob('../data/benchmarks/*/latest-summary.json', {
  eager: true,
  import: 'default',
}) as Record<string, typeof latestSummary>;

function inferBenchmarkVersion(pathname: string) {
  return pathname
    .split('/')
    .find((segment) => /^v\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?$/.test(segment));
}

function benchmarkSummaryForVersion(requestedVersion: string | undefined) {
  if (!requestedVersion) return latestSummary;
  return benchmarkSnapshots[`../data/benchmarks/${requestedVersion}/latest-summary.json`] ?? latestSummary;
}

const benchmarkVersion = version ?? inferBenchmarkVersion(Astro.url.pathname);
const summary = benchmarkSummaryForVersion(benchmarkVersion);

const env = summary.environment as any;
const githubBlobBase = `https://github.com/Clickin/stax-xml/blob/${benchmarkVersion ?? 'master'}/`;
const sourceLinks: Record<Section, Array<[string, string]>> = {
  environment: [['release aggregation', 'packages/benchmark/update-release-benchmarks.mjs']],
  'parser-2kb': [['parser-2kb.mjs', 'packages/benchmark/parser-2kb.mjs'], ['release aggregation', 'packages/benchmark/update-release-benchmarks.mjs']],
  'parser-4kb': [['parser-4kb.mjs', 'packages/benchmark/parser-4kb.mjs'], ['release aggregation', 'packages/benchmark/update-release-benchmarks.mjs']],
  'npm-xml-parsers': [['release aggregation', 'packages/benchmark/update-release-benchmarks.mjs'], ['books fixture', 'packages/benchmark/test-data/books.xml']],
  'parser-13mb': [['parser-13mb.mjs', 'packages/benchmark/parser-13mb.mjs'], ['release aggregation', 'packages/benchmark/update-release-benchmarks.mjs']],
  'parser-98mb': [['parser-98mb.mjs', 'packages/benchmark/parser-98mb.mjs'], ['release aggregation', 'packages/benchmark/update-release-benchmarks.mjs']],
  'async-size': [['EventReader stream release aggregation', 'packages/benchmark/update-release-benchmarks.mjs']],
  converter: [['converter-plain-output-benchmark.mjs', 'packages/benchmark/converter-plain-output-benchmark.mjs'], ['release aggregation', 'packages/benchmark/update-release-benchmarks.mjs']],
  'writer-small': [['writer release aggregation', 'packages/benchmark/update-release-benchmarks.mjs']],
  'writer-big': [['writer release aggregation', 'packages/benchmark/update-release-benchmarks.mjs']],
  'writer-async': [['writer release aggregation', 'packages/benchmark/update-release-benchmarks.mjs']],
  'writer-1gb': [['writer-1gb.mjs', 'packages/benchmark/writer-1gb.mjs'], ['release aggregation', 'packages/benchmark/update-release-benchmarks.mjs']],
};

function suiteCase(suiteId: string, label: string) {
  const suite = summary.suites[suiteId as keyof typeof summary.suites] as any;
  if (!suite) throw new Error(`Missing suite: ${suiteId}`);
  const found = suite.cases.find((entry: any) => entry.label === label);
  if (!found) throw new Error(`Missing benchmark case: ${suiteId} / ${label}`);
  return found;
}

function findSuiteCase(suiteId: string, label: string) {
  const suite = summary.suites[suiteId as keyof typeof summary.suites] as any;
  return suite?.cases.find((entry: any) => entry.label === label);
}

function hasSuite(suiteId: string) {
  return Boolean(summary.suites[suiteId as keyof typeof summary.suites]);
}

function suiteCaseAny(suiteId: string, labels: string | string[]) {
  const candidates = Array.isArray(labels) ? labels : [labels];
  for (const label of candidates) {
    const found = findSuiteCase(suiteId, label);
    if (found) return found;
  }
  throw new Error(`Missing benchmark case: ${suiteId} / ${candidates.join(' | ')}`);
}

function findSuiteCaseAny(suiteId: string, labels: string | string[]) {
  const candidates = Array.isArray(labels) ? labels : [labels];
  for (const label of candidates) {
    const found = findSuiteCase(suiteId, label);
    if (found) return found;
  }
  return undefined;
}

function formatDurationNsCompact(ns: number) {
  if (ns >= 1e9) return `${(ns / 1e9).toFixed(2)} s`;
  if (ns >= 1e6) return `${(ns / 1e6).toFixed(2)} ms`;
  return `${(ns / 1e3).toFixed(2)} µs`;
}

function formatMemory(bytes: number) {
  if (bytes >= 1024 ** 3) return `${(bytes / 1024 ** 3).toFixed(2)} gb`;
  if (bytes >= 1024 ** 2) return `${(bytes / 1024 ** 2).toFixed(2)} mb`;
  return `${(bytes / 1024).toFixed(2)} kb`;
}

function formatOps(avgNs: number) {
  return `~${(1e9 / avgNs).toLocaleString(undefined, { maximumFractionDigits: avgNs < 1e6 ? 0 : 2 })} ops/sec`;
}

function formatThroughput(stats: any) {
  return Number.isFinite(stats?.throughputMiBs) ? `${Number(stats.throughputMiBs).toFixed(2)} MiB/s` : 'n/a';
}

function parseLabel(label: string) {
  if (locale === 'en') return label;
  return label
    .replace('File Size', '파일 크기')
    .replace('Parser Type', '파서 유형')
    .replace('Processing Time', '처리 시간')
    .replace('Memory Usage', '메모리 사용량')
    .replace('Performance Ratio', '성능 비율')
    .replace('Element Count', '요소 수')
    .replace('Async Writer', 'Async Writer')
    .replace('Sync Writer', 'Sync Writer')
    .replace('Average Time', '평균 시간')
    .replace('Operations/sec', '초당 작업 수')
    .replace('Throughput', '처리량')
    .replace('Peak RSS', '최대 RSS')
    .replace('Peak heap', '최대 heap')
    .replace('Written', '기록량')
    .replace('Records', '레코드 수')
    .replace('Target', '목표')
    .replace('Library', '라이브러리')
    .replace('Notes', '비고')
    .replace('Implementation', '구현')
    .replace('Average time', '평균 시간')
    .replace('Fixture', 'fixture')
    .replace('Backend', 'backend')
    .replace('Surface', 'surface')
    .replace('Average', '평균')
    .replace('Peak heap', '최대 heap')
    .replace('Events', '이벤트 수');
}

type TableModel = {
  headers: string[];
  rows: string[][];
};

function buildTable(section: Section): TableModel | null {
  const parserRows = (suiteId: string, rows: Array<[string, string | string[], string]>) => ({
    headers: ['Library', 'Average Time', 'Operations/sec', 'Memory Usage', 'Notes'],
    rows: rows.map(([display, label, note]) => {
      const stats = suiteCaseAny(suiteId, label);
      return [
        display,
        formatDurationNsCompact(stats.avgNs),
        formatOps(stats.avgNs),
        formatMemory(stats.heapAvgBytes),
        note,
      ];
    }),
  });
  const staxSurfaceRows = (suiteId: string): Array<[string, string | string[], string]> => {
    const rows: Array<[string, string | string[], string]> = [];
    if (findSuiteCase(suiteId, 'stax-xml EventReaderSync (native object)')) {
      rows.push(['**EventReaderSync**', 'stax-xml EventReaderSync (native object)', locale === 'en' ? 'Public string event iterator building the same object shape manually' : '같은 object shape를 수동으로 만드는 public string event iterator']);
      rows.push(['**StreamReaderSync**', 'stax-xml StreamReaderSync (native object)', locale === 'en' ? 'Public byte-stream pull reader building the same object shape manually' : '같은 object shape를 수동으로 만드는 public byte-stream pull reader']);
      rows.push(['**ProjectionReader**', 'stax-xml ProjectionReader (native object records)', locale === 'en' ? 'Public projection surface returning the same object shape through object records' : 'object records를 통해 같은 object shape를 반환하는 public projection surface']);
      rows.push(['**Converter**', 'stax-xml Converter API (native object)', locale === 'en' ? 'Declarative schema compiled once and returning the same object shape' : '한 번 compile한 선언형 schema로 같은 object shape를 반환하는 surface']);
    } else if (findSuiteCase(suiteId, 'stax-xml EventReaderSync (native)')) {
      rows.push(['**stax-xml EventReaderSync (native)**', 'stax-xml EventReaderSync (native)', locale === 'en' ? 'Public lean string event reader, native runtime backend' : 'Public lean string event reader, native runtime backend']);
    } else if (findSuiteCase(suiteId, 'stax-xml native NodeIterableReader')) {
      rows.push(['**stax-xml native NodeIterableReader**', 'stax-xml native NodeIterableReader', locale === 'en' ? 'Legacy public NodeIterableReader row from an older benchmark snapshot' : '이전 benchmark snapshot의 legacy public NodeIterableReader row']);
    } else {
      if (findSuiteCase(suiteId, 'stax-xml native addon event aggregate')) {
        rows.push(['stax-xml native addon event aggregate', 'stax-xml native addon event aggregate', locale === 'en' ? 'Historical native aggregate event-object row' : 'Historical native aggregate event-object row']);
      }
      if (findSuiteCase(suiteId, 'stax-xml native addon raw aggregate')) {
        rows.push(['stax-xml native addon raw aggregate', 'stax-xml native addon raw aggregate', locale === 'en' ? 'Historical native aggregate raw row' : 'Historical native aggregate raw row']);
      }
    }
    return rows;
  };

  switch (section) {
    case 'parser-2kb':
      return parserRows('parser-2kb', staxSurfaceRows('parser-2kb'));
    case 'parser-4kb':
      return parserRows('parser-4kb', staxSurfaceRows('parser-4kb'));
    case 'npm-xml-parsers':
      {
        const nativeRows: Array<[string, string | string[], string]> = findSuiteCase('npm-xml-parsers', 'stax-xml EventReaderSync (native)')
          ? [['**stax-xml EventReaderSync (native)**', 'stax-xml EventReaderSync (native)', locale === 'en' ? 'Public string event reader, native runtime backend' : 'Public string event reader, native runtime backend']]
          : findSuiteCase('npm-xml-parsers', 'stax-xml NodeIterableReader (native)')
          ? [['**stax-xml NodeIterableReader (native)**', 'stax-xml NodeIterableReader (native)', locale === 'en' ? 'Legacy public NodeIterableReader row from an older benchmark snapshot' : '이전 benchmark snapshot의 legacy public NodeIterableReader row']]
          : [];
        return parserRows('npm-xml-parsers', [
        ...nativeRows,
        ...(findSuiteCaseAny('npm-xml-parsers', 'stax-xml ProjectionReader parseXmlNodes (native)')
          ? [['**stax-xml ProjectionReader parseXmlNodes (native)**', 'stax-xml ProjectionReader parseXmlNodes (native)', locale === 'en' ? 'Public unknown-schema object projection through stax-xml/projection' : 'Public unknown-schema object projection through stax-xml/projection']] as Array<[string, string, string]>
          : []),
        ['fast-xml-parser XMLParser', 'fast-xml-parser XMLParser', locale === 'en' ? 'Object parser' : 'Object parser'],
        ['txml parse', 'txml parse', locale === 'en' ? 'Lightweight object parser' : '경량 object parser'],
        ['xml2js parseString', 'xml2js parseString', locale === 'en' ? 'Callback object parser' : 'Callback object parser'],
        ['sax strict event parser', 'sax strict event parser', locale === 'en' ? 'Strict SAX event parser' : 'Strict SAX event parser'],
        ['saxes event parser', 'saxes event parser', locale === 'en' ? 'Maintained SAX-style non-validating parser' : 'Maintained SAX-style non-validating parser'],
        ['htmlparser2 xmlMode parser', 'htmlparser2 xmlMode parser', locale === 'en' ? 'Fast HTML/XML event parser in xmlMode' : 'Fast HTML/XML event parser in xmlMode'],
      ]);
      }
    case 'parser-13mb':
      return parserRows('parser-13mb', staxSurfaceRows('parser-13mb'));
    case 'parser-98mb':
      return parserRows('parser-98mb', staxSurfaceRows('parser-98mb'));
    case 'async-size': {
      const candidateSizeRows: Array<[string, string]> = [
        ['async-size', '1MiB'],
        ['async-size', '10MiB'],
        ['async-size', '100MiB'],
        ['async-size', '1GiB'],
        ['async-file-4gb', '4GiB'],
      ];
      const sizeRows = candidateSizeRows.filter(([suiteId]) => hasSuite(suiteId));
      return {
        headers: ['File Size', 'Parser Type', 'Processing Time', 'Memory Usage', 'Throughput'],
        rows: sizeRows.map(([suiteId, size]) => {
          const nativeEventStats = suiteCaseAny(suiteId, [
            `EventReader stream native (${size} temp file)`,
            `async Iterable parser (${size} temp file)`,
          ]);
          return [`${size} temp file`, '**EventReader stream native**', formatDurationNsCompact(nativeEventStats.avgNs), formatMemory(nativeEventStats.heapAvgBytes), `${formatThroughput(nativeEventStats)}`];
        }),
      };
    }
    case 'converter':
      {
        const rows: Array<[string, string, string]> = [
          ['plain parser', formatDurationNsCompact(suiteCase('converter-parity', 'plain parser').avgNs), locale === 'en' ? 'Lowest overhead, handwritten state machine' : '가장 낮은 오버헤드, 수동 상태 관리'],
          ['converter api', formatDurationNsCompact(suiteCase('converter-parity', 'converter api').avgNs), locale === 'en' ? 'Declarative schema with automatic dispatch plan' : '선언형 스키마 + 자동 dispatch plan'],
          ['converter api compiled', formatDurationNsCompact(suiteCase('converter-parity', 'converter api compiled').avgNs), locale === 'en' ? 'Explicit compile() with cached dispatch plan' : '명시적 compile() + cached dispatch plan'],
        ];
        if (findSuiteCase('converter-parity', 'converter api compiled js byte projection')) {
          rows.push([
            'converter api compiled js byte projection',
            formatDurationNsCompact(suiteCase('converter-parity', 'converter api compiled js byte projection').avgNs),
            locale === 'en' ? 'Projection-lowerable byte input through the JavaScript converter path' : 'projection 가능한 byte input, JavaScript converter path',
          ]);
        }
        if (findSuiteCase('converter-parity', 'converter api compiled native byte projection')) {
          rows.push([
            'converter api compiled native byte projection',
            formatDurationNsCompact(suiteCase('converter-parity', 'converter api compiled native byte projection').avgNs),
            locale === 'en' ? 'Projection-lowerable byte input through public native projection' : 'projection 가능한 byte input, public native projection 경로',
          ]);
        }
        if (findSuiteCase('converter-parity', 'ProjectionReader native object rows')) {
          rows.push([
            'ProjectionReader native object rows',
            formatDurationNsCompact(suiteCase('converter-parity', 'ProjectionReader native object rows').avgNs),
            locale === 'en' ? 'Public stax-xml/projection fast surface returning native columnar rows' : 'native columnar row를 반환하는 public stax-xml/projection fast surface',
          ]);
        }
        return {
          headers: ['Implementation', 'Average time', 'Notes'],
          rows,
        };
      }
    case 'writer-small': {
      const rows: Array<[string, string]> = [
        ['fast-xml-parser builder', 'fast-xml-parser builder'],
        ['stax-xml writer', 'Writer API'],
        ['stax-xml writer sync', 'Sync writer API'],
      ];
      if (findSuiteCase('writer-small', 'stax-xml writer sync sink')) {
        rows.push(['stax-xml writer sync sink', 'Sync streaming sink API']);
      }
      rows.push(['xml2js builder', 'xml2js builder']);
      const fastestLabel = rows
        .map(([label]) => [label, suiteCase('writer-small', label).avgNs] as [string, number])
        .sort((a, b) => a[1] - b[1])[0]?.[0];
      const fastestNote = locale === 'en' ? 'Fastest' : '가장 빠름';
      return {
        headers: ['Library', 'Average Time', 'Operations/sec', 'Memory Usage', 'Notes'],
        rows: rows.map(([label, notes]) => {
          const stats = suiteCase('writer-small', label);
          const display = label === 'fast-xml-parser builder' ? '**fast-xml-parser builder**'
            : label === 'stax-xml writer sync' ? '**stax-xml writer sync**'
            : label === 'stax-xml writer sync sink' ? '**stax-xml writer sync sink**'
            : label;
          const resolvedNotes = label === fastestLabel ? `${fastestNote}, ${notes}` : notes;
          return [display, formatDurationNsCompact(stats.avgNs), formatOps(stats.avgNs), formatMemory(stats.heapAvgBytes), resolvedNotes];
        }),
      };
    }
    case 'writer-big': {
      const rows: Array<[string, string]> = [
        ['fast-xml-parser builder (big.json)', 'fast-xml-parser builder'],
        ['stax-xml writer sync (big.json)', 'Sync writer API'],
      ];
      if (findSuiteCase('writer-big', 'stax-xml writer sync sink (big.json)')) {
        rows.push(['stax-xml writer sync sink (big.json)', 'Sync streaming sink API']);
      }
      rows.push(['stax-xml writer (big.json)', 'Writer API']);
      const fastestLabel = rows
        .map(([label]) => [label, suiteCase('writer-big', label).avgNs] as [string, number])
        .sort((a, b) => a[1] - b[1])[0]?.[0];
      const fastestNote = locale === 'en' ? 'Fastest' : '가장 빠름';
      return {
        headers: ['Library', 'Average Time', 'Operations/sec', 'Memory Usage', 'Notes'],
        rows: rows.map(([label, notes]) => {
          const stats = suiteCase('writer-big', label);
          const display = label === 'fast-xml-parser builder (big.json)' ? '**fast-xml-parser builder**'
            : label === 'stax-xml writer sync (big.json)' ? '**stax-xml writer sync**'
            : label === 'stax-xml writer sync sink (big.json)' ? '**stax-xml writer sync sink**'
            : 'stax-xml writer';
          const resolvedNotes = label === fastestLabel ? `${fastestNote}, ${notes}` : notes;
          return [display, formatDurationNsCompact(stats.avgNs), formatOps(stats.avgNs), formatMemory(stats.heapAvgBytes), resolvedNotes];
        }),
      };
    }
    case 'writer-async':
      if (findSuiteCase('writer-async', 'sync writer sink in-memory (1K elements)')) {
        return {
          headers: ['Element Count', 'Async Writer', 'Sync Writer + File', 'Sync Writer + Sink', 'Performance Ratio'],
          rows: [
            ['1K elements', formatDurationNsCompact(suiteCase('writer-async', 'async writer (1K elements)').avgNs), formatDurationNsCompact(suiteCase('writer-async', 'sync writer (1K elements)').avgNs), formatDurationNsCompact(suiteCase('writer-async', 'sync writer sink in-memory (1K elements)').avgNs), `${(suiteCase('writer-async', 'async writer (1K elements)').avgNs / suiteCase('writer-async', 'sync writer sink in-memory (1K elements)').avgNs).toFixed(2)}x ${locale === 'en' ? 'faster (sink)' : '빠름 (sink)'}`],
            ['5K elements', formatDurationNsCompact(suiteCase('writer-async', 'async writer (5K elements)').avgNs), formatDurationNsCompact(suiteCase('writer-async', 'sync writer (5K elements)').avgNs), formatDurationNsCompact(suiteCase('writer-async', 'sync writer sink in-memory (5K elements)').avgNs), `${(suiteCase('writer-async', 'async writer (5K elements)').avgNs / suiteCase('writer-async', 'sync writer sink in-memory (5K elements)').avgNs).toFixed(2)}x ${locale === 'en' ? 'faster (sink)' : '빠름 (sink)'}`],
            ['10K elements', formatDurationNsCompact(suiteCase('writer-async', 'async writer (10K elements)').avgNs), formatDurationNsCompact(suiteCase('writer-async', 'sync writer (10K elements)').avgNs), formatDurationNsCompact(suiteCase('writer-async', 'sync writer sink in-memory (10K elements)').avgNs), `${(suiteCase('writer-async', 'async writer (10K elements)').avgNs / suiteCase('writer-async', 'sync writer sink in-memory (10K elements)').avgNs).toFixed(2)}x ${locale === 'en' ? 'faster (sink)' : '빠름 (sink)'}`],
          ],
        };
      }
      return {
        headers: ['Element Count', 'Async Writer', 'Sync Writer', 'Performance Ratio'],
        rows: [
          ['1K elements', formatDurationNsCompact(suiteCase('writer-async', 'async writer (1K elements)').avgNs), formatDurationNsCompact(suiteCase('writer-async', 'sync writer (1K elements)').avgNs), `${(suiteCase('writer-async', 'async writer (1K elements)').avgNs / suiteCase('writer-async', 'sync writer (1K elements)').avgNs).toFixed(2)}x ${locale === 'en' ? 'faster (sync)' : '빠름 (sync)'}`],
          ['5K elements', formatDurationNsCompact(suiteCase('writer-async', 'async writer (5K elements)').avgNs), formatDurationNsCompact(suiteCase('writer-async', 'sync writer (5K elements)').avgNs), `${(suiteCase('writer-async', 'async writer (5K elements)').avgNs / suiteCase('writer-async', 'sync writer (5K elements)').avgNs).toFixed(2)}x ${locale === 'en' ? 'faster (sync)' : '빠름 (sync)'}`],
          ['10K elements', formatDurationNsCompact(suiteCase('writer-async', 'async writer (10K elements)').avgNs), formatDurationNsCompact(suiteCase('writer-async', 'sync writer (10K elements)').avgNs), `${(suiteCase('writer-async', 'async writer (10K elements)').avgNs / suiteCase('writer-async', 'sync writer (10K elements)').avgNs).toFixed(2)}x ${locale === 'en' ? 'faster (sync)' : '빠름 (sync)'}`],
        ],
      };
    case 'writer-1gb': {
      const rows = [
        ['async writer memory WritableStream', locale === 'en' ? 'Async writer + memory WritableStream' : 'Async writer + 메모리 WritableStream'],
        ['sync writer sink memory', locale === 'en' ? 'Sync sink writer + memory sink' : 'Sync sink writer + 메모리 sink'],
        ['async writer temp file', locale === 'en' ? 'Async writer + temp file' : 'Async writer + 임시 파일'],
        ['sync writer sink temp file', locale === 'en' ? 'Sync sink writer + temp file' : 'Sync sink writer + 임시 파일'],
      ];
      return {
        headers: ['Target', 'Average Time', 'Throughput', 'Peak heap', 'Peak RSS', 'Written', 'Records'],
        rows: rows.map(([label, display]) => {
          const stats = suiteCase('writer-1gb', label);
          return [
            label.includes('sync writer sink') ? `**${display}**` : display,
            formatDurationNsCompact(stats.avgNs),
            `${stats.throughputMiBs.toFixed(2)} MiB/s`,
            formatMemory(stats.heapAvgBytes),
            formatMemory(stats.rssPeakBytes),
            formatMemory(stats.bytesWritten),
            stats.records.toLocaleString(),
          ];
        }),
      };
    }
    default:
      return null;
  }
}

const table = buildTable(section);
const currentSourceLinks = sourceLinks[section] ?? [];
---
{section === 'environment' && (
  <>
    <ul>
      <li><strong>CPU:</strong> {env.cpuName} (~{env.cpuGHz.toFixed(2)} GHz)</li>
      <li><strong>{locale === 'en' ? 'Runtime' : '런타임'}:</strong> {env.runtime} {env.version} ({env.arch}) {locale === 'en' ? 'with garbage collection exposed' : '(`--expose-gc`)'} <code>--expose-gc</code></li>
      <li><strong>{locale === 'en' ? 'Tool' : '도구'}:</strong> <a href="https://github.com/evanw/mitata">Mitata</a></li>
      {env.packageManager && <li><strong>{locale === 'en' ? 'Package manager' : '패키지 매니저'}:</strong> {env.packageManager}</li>}
      <li><strong>Canonical Set:</strong> parser 2KB / 4KB / 13MB / 98MB with stax-xml backend/surface rows, maintained Node npm XML parser comparison, iterable sync/async size comparison from 1MiB to 4GiB, writer small / big / async, converter parity</li>
      <li><strong>{locale === 'en' ? 'Source' : '소스'}:</strong> <a href={`${githubBlobBase}${sourceLinks.environment[0][1]}`}>{sourceLinks.environment[0][0]}</a></li>
    </ul>
    {(env.packages?.length || env.runtimes?.length || env.nodeComponents?.length) && (
      <details>
        <summary>{locale === 'en' ? 'Resolved package and runtime versions' : '해결된 패키지와 런타임 버전'}</summary>
        {env.packages?.length && (
          <table>
            <thead>
              <tr>
                <th>{locale === 'en' ? 'Benchmark package' : 'Benchmark package'}</th>
                <th>{locale === 'en' ? 'Resolved version' : 'Resolved version'}</th>
                <th>{locale === 'en' ? 'Declared range' : 'Declared range'}</th>
                <th>{locale === 'en' ? 'Source' : 'Source'}</th>
              </tr>
            </thead>
            <tbody>
              {env.packages.map((entry: any) => (
                <tr>
                  <td><code>{entry.name}</code></td>
                  <td>{entry.version ?? 'n/a'}</td>
                  <td><code>{entry.declared}</code></td>
                  <td>{entry.source}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
        {env.runtimes?.length && (
          <table>
            <thead>
              <tr>
                <th>{locale === 'en' ? 'Runtime/tool' : 'Runtime/tool'}</th>
                <th>{locale === 'en' ? 'Version' : 'Version'}</th>
                <th>{locale === 'en' ? 'Status' : 'Status'}</th>
              </tr>
            </thead>
            <tbody>
              {env.runtimes.map((entry: any) => (
                <tr>
                  <td><code>{entry.id}</code></td>
                  <td>{entry.version ?? 'n/a'}</td>
                  <td>{entry.status === 'ok' ? 'ok' : entry.reason ?? entry.status}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
        {env.nodeComponents?.length && (
          <table>
            <thead>
              <tr>
                <th>{locale === 'en' ? 'Node component' : 'Node component'}</th>
                <th>{locale === 'en' ? 'Version' : 'Version'}</th>
              </tr>
            </thead>
            <tbody>
              {env.nodeComponents.map((entry: any) => (
                <tr>
                  <td><code>{entry.name}</code></td>
                  <td>{entry.version}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </details>
    )}
  </>
)}

{table && (
  <>
    {currentSourceLinks.length > 0 && (
      <p>
        <strong>{locale === 'en' ? 'Benchmark source' : '벤치마크 소스'}:</strong>{' '}
        {currentSourceLinks.map(([label, path], index) => (
          <>
            {index > 0 && ', '}
            <a href={`${githubBlobBase}${path}`}>{label}</a>
          </>
        ))}
      </p>
    )}
    <table>
      <thead>
        <tr>
          {table.headers.map((header) => <th>{parseLabel(header)}</th>)}
        </tr>
      </thead>
      <tbody>
        {table.rows.map((row) => (
          <tr>
            {row.map((cell, index) => (
              index === 0 && cell.startsWith('**') && cell.endsWith('**')
                ? <td><strong>{cell.slice(2, -2)}</strong></td>
                : <td>{cell}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </>
)}
