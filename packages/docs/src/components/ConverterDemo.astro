---
// Interactive Converter Demo Component
---

<div class="converter-demo-wrapper">
  <div class="demo-container">
    <div class="demo-header">
      <h2>🚀 Interactive Demo</h2>
      <p>Try the converter in your browser</p>
    </div>

    <div class="demo-main">
      <div class="demo-panel">
        <h3>📄 XML Input</h3>
        <textarea id="xmlInput" placeholder="Enter your XML here..."></textarea>
      </div>

      <div class="demo-panel">
        <h3>⚙️ Schema Definition</h3>
        <textarea id="schemaInput" placeholder="Define your schema using 'x' builder..."></textarea>
      </div>

      <div class="demo-examples">
        <h3>📚 Quick Examples</h3>
        <div class="example-buttons" id="exampleButtons"></div>
      </div>

      <div class="demo-controls">
        <div class="mode-toggle">
          <label>Mode:</label>
          <label>
            <input type="radio" name="mode" value="sync" checked> Sync
          </label>
          <label>
            <input type="radio" name="mode" value="async"> Async
          </label>
        </div>
        <button class="btn-primary" id="parseBtn">▶️ Parse XML</button>
        <button class="btn-secondary" id="clearBtn">🗑️ Clear</button>
        <div class="file-upload">
          <input type="file" id="fileInput" accept=".xml,text/xml,application/xml">
          <button class="btn-success" id="loadFileBtn">📁 Load File</button>
        </div>
      </div>

      <div class="demo-panel demo-result">
        <h3>✨ Result</h3>
        <pre id="output">Click "Parse XML" to see the result...</pre>
        <div id="message"></div>
      </div>

      <div class="demo-stats">
        <div class="stat">
          <div class="stat-value" id="parseTime">-</div>
          <div class="stat-label">Parse Time (ms)</div>
        </div>
        <div class="stat">
          <div class="stat-value" id="mode">-</div>
          <div class="stat-label">Mode</div>
        </div>
        <div class="stat">
          <div class="stat-value" id="xmlSize">-</div>
          <div class="stat-label">XML Size (bytes)</div>
        </div>
        <div class="stat">
          <div class="stat-value" id="throughput">-</div>
          <div class="stat-label">Throughput (KB/s)</div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .converter-demo-wrapper {
    margin: 2rem 0;
    width: 100%;
  }

  .demo-container {
    background: white;
    border-radius: 12px;
    border: 1px solid var(--sl-color-gray-5);
    overflow: hidden;
  }

  .demo-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 1.5rem;
    text-align: center;
  }

  .demo-header h2 {
    font-size: 1.8em;
    margin: 0 0 0.5rem 0;
    font-weight: 700;
  }

  .demo-header p {
    margin: 0;
    opacity: 0.95;
  }

  .demo-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding: 1.5rem;
  }

  .demo-panel {
    background: var(--sl-color-gray-6);
    border-radius: 8px;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
  }

  .demo-panel h3 {
    color: var(--sl-color-text);
    margin: 0 0 0.75rem 0;
    font-size: 1.1em;
  }

  textarea, pre {
    width: 100%;
    min-height: 250px;
    padding: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 6px;
    font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Fira Code', 'Consolas', monospace;
    font-size: 13px;
    resize: vertical;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    line-height: 1.5;
  }

  textarea:focus {
    outline: none;
    border-color: #667eea;
  }

  pre {
    background: var(--sl-color-gray-7);
    overflow-x: auto;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  .demo-controls {
    grid-column: 1 / -1;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    padding: 1rem;
    background: var(--sl-color-gray-6);
    border-radius: 8px;
  }

  button {
    padding: 0.75rem 1.5rem;
    font-size: 14px;
    font-weight: 600;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  button:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  }

  button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }

  .btn-secondary {
    background: var(--sl-color-gray-5);
    color: var(--sl-color-text);
  }

  .btn-success {
    background: #28a745;
    color: white;
  }

  .file-upload {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .file-upload input[type="file"] {
    padding: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 6px;
    background: var(--sl-color-bg);
    cursor: pointer;
    font-size: 13px;
  }

  .mode-toggle {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .mode-toggle label {
    font-weight: 600;
    color: var(--sl-color-text);
    font-size: 14px;
  }

  .mode-toggle input[type="radio"] {
    width: 16px;
    height: 16px;
    cursor: pointer;
  }

  .demo-examples {
    grid-column: 1 / -1;
    background: var(--sl-color-gray-6);
    border-radius: 8px;
    padding: 1rem;
  }

  .demo-examples h3 {
    color: var(--sl-color-text);
    margin: 0 0 0.75rem 0;
  }

  .example-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .example-btn {
    padding: 0.5rem 1rem;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-size: 13px;
    color: var(--sl-color-text);
  }

  .example-btn:hover {
    border-color: #667eea;
    background: var(--sl-color-gray-7);
  }

  .example-btn.active {
    border-color: #667eea;
    background: #667eea;
    color: white;
  }

  .demo-result {
    grid-column: 1 / -1;
  }

  .demo-stats {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    padding: 1rem;
    background: var(--sl-color-gray-6);
    border-radius: 8px;
  }

  .stat {
    background: var(--sl-color-bg);
    padding: 1rem;
    border-radius: 6px;
    text-align: center;
    border: 1px solid var(--sl-color-gray-5);
  }

  .stat-value {
    font-size: 1.8em;
    font-weight: bold;
    color: #667eea;
    margin-bottom: 0.25rem;
  }

  .stat-label {
    color: var(--sl-color-text-accent);
    font-size: 0.85em;
  }

  .message {
    padding: 1rem;
    border-radius: 6px;
    margin-top: 1rem;
  }

  .error {
    background: #f8d7da;
    color: #721c24;
    border-left: 4px solid #f5c6cb;
  }

  .success {
    background: #d4edda;
    color: #155724;
    border-left: 4px solid #c3e6cb;
  }

  @media (max-width: 768px) {
    .demo-main {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Import actual stax-xml/converter using relative path
  import { x } from '../../../stax-xml/src/converter/index.js';

  const examples = {
    basic: {
      name: 'Basic Object',
      xml: `<book>
  <title>TypeScript Handbook</title>
  <author>Microsoft</author>
  <price>29.99</price>
  <year>2024</year>
</book>`,
      schema: `x.object({
  title: x.string().xpath('/book/title'),
  author: x.string().xpath('/book/author'),
  price: x.number().xpath('/book/price'),
  year: x.number().xpath('/book/year')
})`
    },
    array: {
      name: 'Array Parsing',
      xml: `<list>
  <item>Apple</item>
  <item>Banana</item>
  <item>Cherry</item>
</list>`,
      schema: `x.array(x.string(), '//item')`
    },
    transform: {
      name: 'With Transform',
      xml: `<person>
  <firstName>John</firstName>
  <lastName>Doe</lastName>
  <age>30</age>
</person>`,
      schema: `x.object({
  firstName: x.string().xpath('/person/firstName'),
  lastName: x.string().xpath('/person/lastName'),
  age: x.number().xpath('/person/age')
}).transform(p => ({
  fullName: p.firstName + ' ' + p.lastName,
  age: p.age,
  isAdult: p.age >= 18
}))`
    },
    validation: {
      name: 'Validation',
      xml: `<data>
  <age>25</age>
  <score>95</score>
</data>`,
      schema: `x.object({
  age: x.number().xpath('/data/age').min(0).max(120).int(),
  score: x.number().xpath('/data/score').min(0).max(100)
})`
    },
    rss: {
      name: 'RSS Feed',
      xml: `<rss version="2.0">
  <channel>
    <title>Tech Blog</title>
    <item>
      <title>TypeScript 5.0</title>
      <link>https://example.com/ts5</link>
    </item>
  </channel>
</rss>`,
      schema: `x.object({
  title: x.string().xpath('/rss/channel/title'),
  items: x.array(
    x.object({
      title: x.string().xpath('./title'),
      link: x.string().xpath('./link')
    }),
    '//item'
  )
})`
    },
    attributes: {
      name: 'Attributes',
      xml: `<product id="123" category="electronics">
  <name>Wireless Mouse</name>
  <price currency="USD">29.99</price>
</product>`,
      schema: `x.object({
  id: x.number().xpath('/product/@id'),
  category: x.string().xpath('/product/@category'),
  name: x.string().xpath('/product/name'),
  price: x.number().xpath('/product/price'),
  currency: x.string().xpath('/product/price/@currency')
})`
    },
    nested: {
      name: 'Nested Arrays',
      xml: `<library>
  <section name="Fiction">
    <book>The Great Gatsby</book>
    <book>1984</book>
  </section>
  <section name="Science">
    <book>A Brief History</book>
  </section>
</library>`,
      schema: `x.object({
  sections: x.array(
    x.object({
      name: x.string().xpath('./@name'),
      books: x.array(x.string(), './book')
    }),
    '//section'
  )
})`
    },
    optional: {
      name: 'Optional Fields',
      xml: `<user>
  <id>123</id>
  <username>johndoe</username>
  <email>john@example.com</email>
</user>`,
      schema: `x.object({
  id: x.number().xpath('/user/id'),
  username: x.string().xpath('/user/username'),
  email: x.string().xpath('/user/email').optional(),
  phone: x.string().xpath('/user/phone').optional()
})`
    }
  };

  // Initialize on DOM ready
  document.addEventListener('DOMContentLoaded', () => {
    const exampleButtons = document.getElementById('exampleButtons');
    if (!exampleButtons) return;

    Object.entries(examples).forEach(([key, example]) => {
      const btn = document.createElement('button');
      btn.className = 'example-btn';
      btn.textContent = example.name;
      btn.onclick = () => loadExample(key);
      exampleButtons.appendChild(btn);
    });

    loadExample('basic');
  });

  function loadExample(key: string) {
    const example = examples[key as keyof typeof examples];
    if (!example) return;

    const xmlInput = document.getElementById('xmlInput') as HTMLTextAreaElement;
    const schemaInput = document.getElementById('schemaInput') as HTMLTextAreaElement;

    if (xmlInput) xmlInput.value = example.xml;
    if (schemaInput) schemaInput.value = example.schema;

    clearOutput();

    document.querySelectorAll('.example-btn').forEach(btn => {
      btn.classList.remove('active');
      if (btn.textContent === example.name) {
        btn.classList.add('active');
      }
    });
  }

  function clearOutput() {
    const output = document.getElementById('output');
    const message = document.getElementById('message');

    if (output) output.textContent = 'Click "Parse XML" to see the result...';
    if (message) message.innerHTML = '';

    ['parseTime', 'mode', 'xmlSize', 'throughput'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.textContent = '-';
    });
  }

  async function parseXML() {
    const xmlInput = (document.getElementById('xmlInput') as HTMLTextAreaElement)?.value;
    const schemaInput = (document.getElementById('schemaInput') as HTMLTextAreaElement)?.value;
    const output = document.getElementById('output');
    const messageDiv = document.getElementById('message');
    const parseBtn = document.getElementById('parseBtn') as HTMLButtonElement;

    if (!xmlInput || !schemaInput) {
      if (messageDiv) messageDiv.innerHTML = '<div class="error">⚠️ Please provide both XML input and schema definition</div>';
      return;
    }

    if (messageDiv) messageDiv.innerHTML = '';
    if (parseBtn) parseBtn.disabled = true;

    const mode = (document.querySelector('input[name="mode"]:checked') as HTMLInputElement)?.value || 'sync';
    const startTime = performance.now();

    try {
      const schema = eval(schemaInput);
      let result;

      if (mode === 'sync') {
        result = schema.parseSync(xmlInput);
      } else {
        const encoder = new TextEncoder();
        const stream = new ReadableStream({
          start(controller) {
            controller.enqueue(encoder.encode(xmlInput));
            controller.close();
          }
        });
        result = await schema.parse(stream);
      }

      const endTime = performance.now();
      const duration = (endTime - startTime).toFixed(2);

      if (output) output.textContent = JSON.stringify(result, null, 2);

      const xmlSize = new Blob([xmlInput]).size;
      const throughput = ((xmlSize / 1024) / (parseFloat(duration) / 1000)).toFixed(2);

      const stats = {
        parseTime: duration,
        mode: mode.toUpperCase(),
        xmlSize: xmlSize.toLocaleString(),
        throughput
      };

      Object.entries(stats).forEach(([id, value]) => {
        const el = document.getElementById(id);
        if (el) el.textContent = value.toString();
      });

      if (messageDiv) {
        messageDiv.innerHTML = `<div class="success">✅ Successfully parsed XML in ${duration}ms using ${mode} mode</div>`;
      }
    } catch (error) {
      if (output) output.textContent = '';
      if (messageDiv) {
        messageDiv.innerHTML = `<div class="error">❌ Error: ${(error as Error).message}</div>`;
      }
      console.error('Parse error:', error);
    } finally {
      if (parseBtn) parseBtn.disabled = false;
    }
  }

  async function loadFile() {
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const file = fileInput?.files?.[0];
    const messageDiv = document.getElementById('message');

    if (!file) {
      if (messageDiv) messageDiv.innerHTML = '<div class="error">⚠️ Please select a file</div>';
      return;
    }

    const maxSize = 10 * 1024 * 1024;
    if (file.size > maxSize) {
      if (messageDiv) messageDiv.innerHTML = '<div class="error">⚠️ File too large. Maximum size is 10MB</div>';
      return;
    }

    try {
      const text = await file.text();
      const xmlInput = document.getElementById('xmlInput') as HTMLTextAreaElement;
      if (xmlInput) xmlInput.value = text;

      if (messageDiv) {
        messageDiv.innerHTML = `<div class="success">✅ Loaded file: ${file.name} (${(file.size / 1024).toFixed(2)} KB)</div>`;
        setTimeout(() => { messageDiv.innerHTML = ''; }, 3000);
      }
    } catch (error) {
      if (messageDiv) {
        messageDiv.innerHTML = `<div class="error">❌ Failed to load file: ${(error as Error).message}</div>`;
      }
    }
  }

  // Event listeners
  document.getElementById('parseBtn')?.addEventListener('click', parseXML);
  document.getElementById('clearBtn')?.addEventListener('click', clearOutput);
  document.getElementById('loadFileBtn')?.addEventListener('click', loadFile);
</script>
