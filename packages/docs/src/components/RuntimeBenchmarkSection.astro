---
import runtimeMatrix from '../../../benchmark/results/release/runtime-matrix.json';
import crossRuntime from '../../../benchmark/results/release/cross-runtime-comparison.json';

type Locale = 'en' | 'ko';
type Section = 'runtime-matrix' | 'cross-runtime' | 'java25';

interface Props {
  locale: Locale;
  section: Section;
}

const { locale, section } = Astro.props as Props;
const githubBlobBase = 'https://github.com/Clickin/stax-xml/blob/master/';
const sourceLinks: Record<Section, Array<[string, string]>> = {
  'runtime-matrix': [['runtime-matrix.mjs', 'packages/benchmark/runtime-matrix.mjs']],
  'cross-runtime': [['cross-runtime-comparison.mjs', 'packages/benchmark/cross-runtime-comparison.mjs']],
  java25: [['cross-runtime-comparison.mjs', 'packages/benchmark/cross-runtime-comparison.mjs']],
};
const currentSourceLinks = sourceLinks[section];

function formatRate(value: number | null | undefined) {
  return Number.isFinite(value) ? `${Number(value).toFixed(1)} MiB/s` : 'n/a';
}

function formatMs(value: number | null | undefined) {
  return Number.isFinite(value) ? `${Number(value).toFixed(2)} ms` : 'n/a';
}

function formatPct(value: number | null | undefined) {
  return Number.isFinite(value) ? `${Number(value) >= 0 ? '+' : ''}${(Number(value) * 100).toFixed(1)}%` : 'n/a';
}

function scenarioLabel(id: string) {
  if (locale === 'en') return id;
  return id
    .replace('public-sync-full-string', 'public sync full-string')
    .replace('iterable-count-only', 'iterable count-only')
    .replace('iterable-full-string', 'iterable full-string');
}

function crossScenario(tier: any, id: string) {
  return tier.scenarios.find((scenario: any) => scenario.id === id);
}

function crossNativeTier(tierId: string) {
  return crossRuntime.nativeAddon?.tiers?.find((tier: any) => tier.tier === tierId);
}

function crossComparatorStatus(result: any) {
  if (!result) return 'missing';
  if (result.status === 'ok') return 'ok';
  return result.reason ?? result.status ?? 'n/a';
}

function crossRelativeToJs(result: any, jsNode: any) {
  if (!result?.mibPerSec || !jsNode?.mibPerSec) return 'n/a';
  return `${(result.mibPerSec / jsNode.mibPerSec).toFixed(2)}x`;
}

const runtimeRows = runtimeMatrix.results.flatMap((result: any) => {
  if (result.status !== 'ok') {
    return [[result.runtime.id, result.status, 'n/a', 'n/a', 'n/a', result.reason ?? '']];
  }
  return result.scenarios.map((scenario: any) => [
    result.runtime.id,
    result.runtime.version,
    scenarioLabel(scenario.id),
    formatRate(scenario.mibPerSec),
    formatMs(scenario.avgMs),
    String(scenario.checksum),
  ]);
});

const crossTierTables = crossRuntime.nodeStringReturn.files[0].tiers.map((tier: any) => {
  const jsNode = crossScenario(tier, 'node');
  const rows = [
    ['stax-xml JS on Node', jsNode],
    ['stax-xml native addon (JS wrapper)', crossNativeTier(tier.id)],
    ['Woodstox on Java 8', crossScenario(tier, 'woodstox')],
    ['quick-xml', crossScenario(tier, 'quick-xml')],
  ].map(([label, result]: any[]) => [
    label,
    formatRate(result?.mibPerSec),
    formatMs(result?.avgMs),
    crossRelativeToJs(result, jsNode),
    crossComparatorStatus(result),
  ]);
  return { tier: tier.id, rows };
});

const java25Rows = crossRuntime.java25Verification.tiers.map((entry: any) => [
  entry.tier,
  formatRate(entry.java8MibPerSec),
  formatRate(entry.java25?.mibPerSec),
  formatPct(entry.deltaVsJava8),
  entry.java25?.status ?? 'skipped',
]);
---

{currentSourceLinks.length > 0 && (
  <p>
    <strong>{locale === 'en' ? 'Benchmark source' : '벤치마크 소스'}:</strong>{' '}
    {currentSourceLinks.map(([label, path], index) => (
      <>
        {index > 0 && ', '}
        <a href={`${githubBlobBase}${path}`}>{label}</a>
      </>
    ))}
  </p>
)}

{section === 'runtime-matrix' && (
  <table>
    <thead>
      <tr>
        <th>{locale === 'en' ? 'Runtime' : '런타임'}</th>
        <th>{locale === 'en' ? 'Version' : '버전'}</th>
        <th>{locale === 'en' ? 'Scenario' : '시나리오'}</th>
        <th>{locale === 'en' ? 'Throughput' : '처리량'}</th>
        <th>{locale === 'en' ? 'Average' : '평균'}</th>
        <th>Checksum</th>
      </tr>
    </thead>
    <tbody>
      {runtimeRows.map((row: string[]) => (
        <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
      ))}
    </tbody>
  </table>
)}

{section === 'cross-runtime' && (
  <>
    {crossTierTables.map((table: { tier: string; rows: string[][] }) => (
      <>
        <h4>{table.tier}</h4>
        <table>
          <thead>
            <tr>
              <th>{locale === 'en' ? 'Implementation' : '구현'}</th>
              <th>{locale === 'en' ? 'Throughput' : '처리량'}</th>
              <th>{locale === 'en' ? 'Average' : '평균'}</th>
              <th>{locale === 'en' ? 'Relative to stax-xml JS' : 'stax-xml JS 대비'}</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {table.rows.map((row: string[]) => (
              <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </>
    ))}
  </>
)}

{section === 'java25' && (
  <table>
    <thead>
      <tr>
        <th>Tier</th>
        <th>Woodstox Java 8</th>
        <th>Woodstox Java 25</th>
        <th>{locale === 'en' ? 'Delta' : '차이'}</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      {java25Rows.map((row: string[]) => (
        <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
      ))}
    </tbody>
  </table>
)}
