---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StAX-XML Converter Interactive Demo</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      padding: 20px;
    }

    .container {
      max-width: 1600px;
      margin: 0 auto;
      background: white;
      border-radius: 16px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      overflow: hidden;
    }

    .header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 30px;
      text-align: center;
    }

    .header h1 {
      font-size: 2.5em;
      margin-bottom: 10px;
      font-weight: 700;
    }

    .header p {
      font-size: 1.1em;
      opacity: 0.95;
    }

    .badge {
      display: inline-block;
      background: rgba(255,255,255,0.2);
      padding: 5px 15px;
      border-radius: 20px;
      font-size: 0.9em;
      margin-top: 10px;
      margin-right: 10px;
    }

    .main {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      padding: 30px;
    }

    .panel {
      background: #f8f9fa;
      border-radius: 12px;
      padding: 20px;
      border: 2px solid #e9ecef;
    }

    .panel h2 {
      color: #495057;
      margin-bottom: 15px;
      font-size: 1.3em;
    }

    textarea, pre {
      width: 100%;
      min-height: 300px;
      padding: 15px;
      border: 2px solid #dee2e6;
      border-radius: 8px;
      font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Fira Code', 'Consolas', monospace;
      font-size: 13px;
      resize: vertical;
      background: white;
      line-height: 1.5;
    }

    textarea:focus {
      outline: none;
      border-color: #667eea;
    }

    pre {
      background: #2d3748;
      color: #e2e8f0;
      overflow-x: auto;
      white-space: pre-wrap;
      word-wrap: break-word;
    }

    .controls {
      grid-column: 1 / -1;
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
      justify-content: center;
      padding: 20px;
      background: #f8f9fa;
      border-radius: 12px;
    }

    button {
      padding: 12px 30px;
      font-size: 16px;
      font-weight: 600;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    button:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 6px 12px rgba(0,0,0,0.15);
    }

    button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .btn-primary {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }

    .btn-secondary {
      background: #6c757d;
      color: white;
    }

    .btn-success {
      background: #28a745;
      color: white;
    }

    .file-upload {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .file-upload input[type="file"] {
      padding: 8px;
      border: 2px solid #dee2e6;
      border-radius: 6px;
      background: white;
      cursor: pointer;
    }

    .mode-toggle {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .mode-toggle label {
      font-weight: 600;
      color: #495057;
    }

    .mode-toggle input[type="radio"] {
      width: 18px;
      height: 18px;
      cursor: pointer;
    }

    .examples {
      grid-column: 1 / -1;
      background: #f8f9fa;
      border-radius: 12px;
      padding: 20px;
    }

    .examples h3 {
      color: #495057;
      margin-bottom: 15px;
    }

    .example-buttons {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .example-btn {
      padding: 8px 16px;
      background: white;
      border: 2px solid #dee2e6;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.2s ease;
      font-size: 14px;
    }

    .example-btn:hover {
      border-color: #667eea;
      background: #f0f0ff;
    }

    .example-btn.active {
      border-color: #667eea;
      background: #667eea;
      color: white;
    }

    .stats {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 15px;
      padding: 20px;
      background: #f8f9fa;
      border-radius: 12px;
    }

    .stat {
      background: white;
      padding: 15px;
      border-radius: 8px;
      text-align: center;
      border: 2px solid #e9ecef;
    }

    .stat-value {
      font-size: 2em;
      font-weight: bold;
      color: #667eea;
      margin-bottom: 5px;
    }

    .stat-label {
      color: #6c757d;
      font-size: 0.9em;
    }

    .message {
      padding: 15px;
      border-radius: 8px;
      margin-top: 15px;
    }

    .error {
      background: #f8d7da;
      color: #721c24;
      border-left: 4px solid #f5c6cb;
    }

    .success {
      background: #d4edda;
      color: #155724;
      border-left: 4px solid #c3e6cb;
    }

    .info {
      background: #d1ecf1;
      color: #0c5460;
      border-left: 4px solid #bee5eb;
    }

    @media (max-width: 768px) {
      .main {
        grid-template-columns: 1fr;
      }
      .header h1 {
        font-size: 1.8em;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>🚀 StAX-XML Converter Demo</h1>
      <p>Type-safe, declarative XML parsing with XPath support</p>
      <div>
        <span class="badge">Zod-inspired API</span>
        <span class="badge">Real stax-xml/converter</span>
      </div>
    </div>

    <div class="main">
      <div class="panel">
        <h2>📄 XML Input</h2>
        <textarea id="xmlInput" placeholder="Enter your XML here..."></textarea>
      </div>

      <div class="panel">
        <h2>⚙️ Schema Definition</h2>
        <textarea id="schemaInput" placeholder="Define your schema using 'x' builder..."></textarea>
      </div>

      <div class="examples">
        <h3>📚 Quick Examples</h3>
        <div class="example-buttons" id="exampleButtons"></div>
      </div>

      <div class="controls">
        <div class="mode-toggle">
          <label>Mode:</label>
          <label>
            <input type="radio" name="mode" value="sync" checked> Sync
          </label>
          <label>
            <input type="radio" name="mode" value="async"> Async
          </label>
        </div>
        <button class="btn-primary" id="parseBtn">▶️ Parse XML</button>
        <button class="btn-secondary" id="clearBtn">🗑️ Clear</button>
        <div class="file-upload">
          <input type="file" id="fileInput" accept=".xml,text/xml,application/xml">
        </div>
      </div>

      <div class="panel" style="grid-column: 1 / -1;">
        <h2>ℹ️ Demo Notes</h2>
        <div id="modeNotice" class="message info">
          Sync mode parses the textarea contents directly. Async mode runs the converter in a Web Worker and is required for files over 10MB.
        </div>
      </div>

      <div class="panel" style="grid-column: 1 / -1;">
        <h2>✨ Result</h2>
        <pre id="output">Click "Parse XML" to see the result...</pre>
        <div id="message"></div>
      </div>

      <div class="stats">
        <div class="stat">
          <div class="stat-value" id="parseTime">-</div>
          <div class="stat-label">Parse Time (ms)</div>
        </div>
        <div class="stat">
          <div class="stat-value" id="mode">-</div>
          <div class="stat-label">Mode</div>
        </div>
        <div class="stat">
          <div class="stat-value" id="xmlSize">-</div>
          <div class="stat-label">XML Size (bytes)</div>
        </div>
        <div class="stat">
          <div class="stat-value" id="throughput">-</div>
          <div class="stat-label">Throughput (KB/s)</div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import "../../scripts/converter-demo.ts";
  </script>
</body>
</html>
