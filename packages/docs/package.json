{
  "name": "stax-xml-docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "echo \"TypeDoc should be generated manually with: pnpm --filter=stax-xml-docs typedoc\"",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typedoc": "cd ../stax-xml && pnpm typedoc:converter && pnpm typedoc:main && cd ../docs && tsx scripts/add-frontmatter.ts",
    "snapshot:release": "node scripts/snapshot-release-docs.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/starlight": "^0.41.3",
    "astro": "^7.0.7",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "0.41.1",
    "sharp": "^0.34.5",
    "starlight-typedoc": "^0.23.0",
    "stax-xml": "workspace:*",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3"
  }
}
