    {
      "id": "browser-byte-batch-contract",
      "summary": "Prepared rows consume corpus-backed browser Uint8Array batches through a synchronous Iterable<Uint8Array[]> and live fetch rows consume Response.body without loading a full XML string.",
      "evidence": [
        "fixtureSource=corpus-file",
        "rowCycleSize=1",
        "batchSize=1",
        "stringFull: maxJsHeap=9.0 MiB",
        "eventObjectFull: maxJsHeap=27.0 MiB",
        "cursorAccessor: maxJsHeap=10.2 MiB",
        "rawFrameDirect: maxJsHeap=25.9 MiB",
        "rawFrameNameId: maxJsHeap=30.7 MiB",
        "fetchReadableStreamFull: maxJsHeap=27.6 MiB",
        "fetchAsyncByteBatchFull: maxJsHeap=21.7 MiB"
      ]
    },
    {
      "id": "browser-streaming-source-gap",
      "summary": "Most corpus-cycle rows still load a fixture seed with arrayBuffer() before replay; fetchReadableStreamFull and fetchAsyncByteBatchFull separately measure direct fetch Response.body consumption.",
      "evidence": [
        "createFixtureRows(corpus-cycle) returns [new Uint8Array(await response.arrayBuffer())] for StreamReaderSync rows.",
        "StreamReaderSync(byteBatches(fixture)) pulls one synchronous batch at a time.",
        "fetchReadableStreamFull consumes /corpus-cycle-stream through EventReader.",
        "fetchAsyncByteBatchFull consumes /corpus-cycle-stream through AsyncIterable<Uint8Array[]> batches built by reader.read() demand."
      ]
    },
