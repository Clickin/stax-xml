{
  "name": "benchmark",
  "type": "module",
  "private": true,
  "scripts": {
    "// Direct benchmark scripts (.mjs)": "",
    "dev:parser:2kb": "node --expose-gc ./parser-2kb.mjs",
    "dev:parser:4kb": "node --expose-gc ./parser-4kb.mjs",
    "dev:parser:13mb": "node --expose-gc ./parser-13mb.mjs",
    "dev:parser:98mb": "node --expose-gc ./parser-98mb.mjs",
    "dev:builder:small": "node --expose-gc ./builder-small.mjs",
    "dev:builder:big": "node --expose-gc ./builder-big.mjs",
    "dev:async:parser": "node --expose-gc ./async-parser.mjs",
    "dev:async:fast-path:poc": "node --expose-gc ./async-fast-path-poc.mjs --quick",
    "dev:async:large-compare": "node --expose-gc ./large-file-parser-compare.mjs",
    "dev:async:writer": "node --expose-gc ./async-writer.mjs",
    "dev:node-string-return": "node --expose-gc ./node-string-return.mjs --quick",
    "dev:converter:plain-output": "node --expose-gc ./converter-plain-output-benchmark.mjs",
    "dev:bench:sync": "pnpm run dev:parser:2kb && pnpm run dev:parser:4kb && pnpm run dev:parser:13mb && pnpm run dev:parser:98mb && pnpm run dev:builder:small && pnpm run dev:builder:big",
    "dev:bench:async": "pnpm run dev:async:parser && pnpm run dev:async:writer",
    "dev:bench:all": "pnpm run dev:bench:sync && pnpm run dev:bench:async",
    "dev:writer:core": "node --expose-gc ./writer-core.mjs",
    "dev:writer:1gb": "node --expose-gc ./writer-1gb.mjs --quick",
    "dev:writer:1gb:json": "node --expose-gc ./writer-1gb.mjs --quick --json-out results/release/raw/writer-1gb.json",
    "release:update": "node --expose-gc ./update-release-benchmarks.mjs",
    "release:aggregate": "node --expose-gc ./aggregate-release-benchmarks.mjs",
    "// Benchmark aliases": "",
    "bench:parser:2kb": "node --expose-gc ./parser-2kb.mjs",
    "bench:parser:4kb": "node --expose-gc ./parser-4kb.mjs",
    "bench:parser:13mb": "node --expose-gc ./parser-13mb.mjs",
    "bench:parser:98mb": "node --expose-gc ./parser-98mb.mjs",
    "bench:builder:small": "node --expose-gc ./builder-small.mjs",
    "bench:builder:big": "node --expose-gc ./builder-big.mjs",
    "bench:async:parser": "node --expose-gc ./async-parser.mjs",
    "bench:async:fast-path:poc": "node --expose-gc ./async-fast-path-poc.mjs",
    "bench:async:writer": "node --expose-gc ./async-writer.mjs",
    "bench:node-string-return": "node --expose-gc ./node-string-return.mjs --sizes-mib 512,1024 --fail-gate",
    "bench:converter:plain-output": "node --expose-gc ./converter-plain-output-benchmark.mjs",
    "bench:writer:core": "node --expose-gc ./writer-core.mjs",
    "bench:writer:1gb": "node --expose-gc ./writer-1gb.mjs --size-gb 1",
    "bench:writer:1gb:json": "node --expose-gc ./writer-1gb.mjs --size-gb 1 --json-out results/release/raw/writer-1gb.json",
    "bench:sync": "pnpm run bench:parser:2kb && pnpm run bench:parser:4kb && pnpm run bench:parser:13mb && pnpm run bench:parser:98mb && pnpm run bench:builder:small && pnpm run bench:builder:big",
    "bench:async": "pnpm run bench:async:parser && pnpm run bench:async:writer",
    "bench:all": "pnpm run bench:sync && pnpm run bench:async",
    "// Baseline Performance Benchmarks": "",
    "generate:testdata": "node generate-test-xmls.mjs",
    "bench:baseline": "node --expose-gc benchmark-baseline.mjs",
    "bench:baseline:quick": "node --expose-gc benchmark-baseline.mjs --iterations 50",
    "// GC Pressure Measurement": "",
    "example:gc": "node --expose-gc example-gc-benchmark.mjs",
    "// Complete workflow": "",
    "workflow:full": "pnpm run generate:testdata && pnpm run bench:baseline"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "mitata": "^1.0.34",
    "sax": "^1.4.1",
    "stax-xml": "workspace:*",
    "txml": "^5.1.1",
    "xml2js": "^0.6.2"
  }
}
