{
  "name": "@stax-xml/native-aggregate-probe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "stax_xml_native_aggregate.node"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build:native": "node ./build.mjs",
    "build:wasm": "node ./scripts/build-wasm.mjs",
    "build:wasm:simd": "node ./scripts/build-wasm.mjs --simd128",
    "coverage:native": "node ./scripts/native-branch-coverage.mjs",
    "stage:platform": "node ./scripts/stage-platform-package.mjs",
    "smoke": "node ./smoke.mjs"
  },
  "dependencies": {
    "@emnapi/core": "1.10.0",
    "@emnapi/runtime": "1.10.0",
    "@emnapi/wasi-threads": "1.2.1",
    "@napi-rs/wasm-runtime": "1.1.4"
  },
  "napi": {
    "binaryName": "stax_xml_native_aggregate",
    "targets": [
      "wasm32-wasip1-threads"
    ],
    "wasm": {
      "browser": {
        "asyncInit": true
      }
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "3.6.2"
  }
}
