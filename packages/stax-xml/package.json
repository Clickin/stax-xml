{
  "name": "stax-xml",
  "version": "1.0.0-rc3",
  "author": "Clickin <josh87786@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clickin/stax-xml.git"
  },
  "devDependencies": {
    "starlight-typedoc": "^0.21.5",
    "tsdown": "^0.21.9",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cursor": {
      "types": "./dist/cursor.d.ts",
      "import": "./dist/cursor.js"
    },
    "./converter": {
      "types": "./dist/converter.d.ts",
      "import": "./dist/converter.js"
    },
    "./iterable": {
      "types": "./dist/iterable.d.ts",
      "import": "./dist/iterable.js"
    },
    "./iterable/node": {
      "types": "./dist/iterable/node.d.ts",
      "import": "./dist/iterable/node.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./adapters/node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./adapters/bun": {
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js"
    },
    "./adapters/deno": {
      "types": "./dist/deno.d.ts",
      "import": "./dist/deno.js"
    }
  },
  "bugs": "https://github.com/Clickin/stax-xml/issues",
  "description": "High-performance, pull-based XML parser for JavaScript/TypeScript with declarative converter API",
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/Clickin/stax-xml",
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "xml",
    "stax",
    "parser",
    "writer"
  ],
  "license": "MIT",
  "optionalDependencies": {
    "@stax-xml/native-darwin-arm64": "1.0.0-rc3",
    "@stax-xml/native-darwin-x64": "1.0.0-rc3",
    "@stax-xml/native-linux-arm64-gnu": "1.0.0-rc3",
    "@stax-xml/native-linux-arm64-musl": "1.0.0-rc3",
    "@stax-xml/native-linux-x64-gnu": "1.0.0-rc3",
    "@stax-xml/native-linux-x64-musl": "1.0.0-rc3",
    "@stax-xml/native-wasm32-wasi": "1.0.0-rc3",
    "@stax-xml/native-win32-arm64-msvc": "1.0.0-rc3",
    "@stax-xml/native-win32-x64-msvc": "1.0.0-rc3"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:w3c": "tsx ./scripts/w3c-xmlts.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "coverage:branch-report": "node ./scripts/branch-coverage-report.mjs",
    "coverage:branch-gate": "node ./scripts/branch-coverage-report.mjs --fail",
    "performance": "node --expose-gc ./performance/large-file.ts",
    "prepublishOnly": "pnpm build",
    "typedoc": "typedoc",
    "typedoc:main": "typedoc --options typedoc.main.json",
    "typedoc:converter": "typedoc --options typedoc.converter.json"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
