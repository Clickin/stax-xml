{
  "entryPoints": [
    "./src/index.ts",
    "./src/converter.ts"
  ],
  "out": "./docs/api",
  "plugin": [
    "./node_modules/typedoc-plugin-markdown/dist/index.js"
  ],
  "gitRevision": "master",
  "readme": "none",
  "sort": [
    "source-order"
  ],
  "categoryOrder": [
    "*",
    "Other"
  ],
  "hideGenerator": true,
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "searchInComments": true,
  "cleanOutputDir": true,
  "tsconfig": "./tsconfig.json",
  "theme": "markdown",
  "entryPointStrategy": "expand",
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  }
}
