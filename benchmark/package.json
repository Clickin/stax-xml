{
  "name": "benchmark",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "// Development scripts (tsx)": "",
    "dev:parser:2kb": "tsx --expose-gc ./parser-2kb.ts",
    "dev:parser:4kb": "tsx --expose-gc ./parser-4kb.ts",
    "dev:builder:small": "tsx --expose-gc ./builder-small.ts",
    "dev:builder:big": "tsx --expose-gc ./builder-big.ts",
    "dev:async:parser": "tsx --expose-gc ./async-parser.ts",
    "dev:async:large-compare": "tsx --expose-gc ./large-file-parser-compare.ts",
    "dev:async:writer": "tsx --expose-gc ./async-writer.ts",
    "dev:bench:sync": "npm run dev:parser:2kb && npm run dev:parser:4kb && npm run dev:builder:small && npm run dev:builder:big",
    "dev:bench:async": "npm run dev:async:parser && npm run dev:async:writer",
    "dev:bench:all": "npm run dev:bench:sync && npm run dev:bench:async",
    "// Build configuration": "",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "// Production benchmarks (compiled JS)": "",
    "bench:parser:2kb": "node --expose-gc ./dist/parser-2kb.js",
    "bench:parser:4kb": "node --expose-gc ./dist/parser-4kb.js",
    "bench:builder:small": "node --expose-gc ./dist/builder-small.js",
    "bench:builder:big": "node --expose-gc ./dist/builder-big.js",
    "bench:async:parser": "node --expose-gc ./dist/async-parser.js",
    "bench:async:writer": "node --expose-gc ./dist/async-writer.js",
    "bench:sync": "npm run bench:parser:2kb && npm run bench:parser:4kb && npm run bench:builder:small && npm run bench:builder:big",
    "bench:async": "npm run bench:async:parser && npm run bench:async:writer",
    "bench:all": "npm run bench:sync && npm run bench:async",
    "prebench:all": "npm run build",
    "// Legacy scripts (mjs)": "",
    "legacy:parser": "node --expose-gc ./parser.mjs",
    "legacy:builder": "node --expose-gc ./builder.mjs"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/node": "^24.0.10",
    "fast-xml-parser": "^5.2.5",
    "mitata": "^1.0.34",
    "stax-xml": "^0.2.5",
    "txml": "^5.1.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/xml2js": "^0.4.14",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.5"
  }
}