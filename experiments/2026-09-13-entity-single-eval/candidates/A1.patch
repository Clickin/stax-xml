--- /dev/null
+++ b/packages/stax-xml/scripts/generate-entity-materializing-cursor.mjs
@@ -0,0 +1,98 @@
+import ts from 'typescript';
+import { readFileSync, writeFileSync } from 'node:fs';
+import { createHash } from 'node:crypto';
+import { fileURLToPath } from 'node:url';
+const sourcePath = fileURLToPath(new URL('../src/core/TokenCursor.ts', import.meta.url));
+const outputPath = fileURLToPath(new URL('../src/core/internal/MaterializingTokenCursor.ts', import.meta.url));
+const args = process.argv.slice(2);
+let variant;
+let check = false;
+for (let i = 0; i < args.length; i++) {
+  if (args[i] === '--variant') variant = args[++i];
+  else if (args[i] === '--check') check = true;
+  else throw new Error(`Unknown option: ${args[i]}`);
+}
+if (!variant) {
+  try { variant = /variant: ([a-z-]+)/.exec(readFileSync(outputPath, 'utf8'))?.[1]; } catch {}
+}
+variant ??= 'attributes';
+if (!['wiring', 'attributes', 'attributes-text'].includes(variant)) throw new Error(`Invalid variant: ${variant}`);
+const source = readFileSync(sourcePath, 'utf8');
+const sf = ts.createSourceFile(sourcePath, source, ts.ScriptTarget.Latest, true);
+const klass = sf.statements.find(n => ts.isClassDeclaration(n) && n.name.text === 'TokenCursor');
+const members = new Map(klass.members.map(n => [n.name?.getText(sf), n]));
+const fingerprints = {};
+function specialize(name, changes = []) {
+  const node = members.get(name);
+  if (!node) throw new Error(`Missing member ${name}`);
+  fingerprints[name] = createHash('sha256').update(node.getText(sf)).digest('hex');
+  const edits = [];
+  for (const [predicate, replacement] of changes) {
+    const matches = [];
+    function visit(n) { if (predicate(n)) matches.push(n); ts.forEachChild(n, visit); }
+    visit(node);
+    if (matches.length !== 1) throw new Error(`${name}: expected one anchor, found ${matches.length}`);
+    const hit = matches[0];
+    edits.push([hit.getStart(sf), hit.end, typeof replacement === 'function' ? replacement(hit) : replacement]);
+  }
+  const visibility = node.modifiers?.find(n => n.kind === ts.SyntaxKind.PrivateKeyword || n.kind === ts.SyntaxKind.ProtectedKeyword);
+  if (visibility) edits.push([visibility.getStart(sf), visibility.end, 'protected override']);
+  else edits.push([node.getStart(sf), node.getStart(sf), 'override ']);
+  let text = node.getText(sf);
+  for (const [start, end, value] of edits.sort((a,b) => b[0]-a[0])) text = text.slice(0,start-node.getStart(sf)) + value + text.slice(end-node.getStart(sf));
+  return text;
+}
+const call = name => n => ts.isCallExpression(n) && n.expression.getText(sf) === name;
+const expr = text => n => ts.isExpressionStatement(n) && n.expression.getText(sf) === text;
+// Changes inside a method are disjoint AST anchors; no global text replacement.
+let methods = [];
+if (variant !== 'wiring') {
+  const parse = members.get('parseStart');
+  const changes = [
+    [call('findValidatedAttributeEnd'), 'this.buffer.indexOf(String.fromCharCode(quote), cursor)'],
+    [expr('cursor = valueEnd + 1'), 'this.normalizedAttributeValues[rawCount] = validateAndNormalizeAttributeSpan(this.buffer, valueStart, valueEnd, this.customEntities);\n      cursor = valueEnd + 1;'],
+    [call('decodeEntities'), 'this.normalizedAttributeValues[index] ??= this.buffer.slice(this.attributeValueStarts[index]!, this.attributeValueEnds[index]!)'],
+  ];
+  // Insert entry guard at the first existing statement, preserving its AST body.
+  changes.push([n => n === parse.body.statements[0], n => `if (!this.autoDecodeEntities) return super.parseStart();\nthis.normalizedAttributeValues.length = 0;\n${n.getText(sf)}`]);
+  methods.push(specialize('parseStart', changes));
+  methods.push(specialize('materializeAttribute', [
+    [n => ts.isPropertyAssignment(n) && n.name.getText(sf) === 'value', 'value: this.attributeValue(index)'],
+    [n => n === members.get('materializeAttribute').body.statements[0], n => `if (!this.autoDecodeEntities) return super.materializeAttribute(index);\n${n.getText(sf)}`],
+  ]));
+  fingerprints.attributeValue = createHash('sha256').update(members.get('attributeValue').getText(sf)).digest('hex');
+  methods.push(`override attributeValue(index: number): string | undefined {
+    if (!this.autoDecodeEntities) return super.attributeValue(index);
+    if (index < 0 || index >= this.currentAttributeCount) return undefined;
+    return this.normalizedAttributeValues[index] ??= this.buffer.slice(this.attributeValueStarts[index]!, this.attributeValueEnds[index]!);
+  }`);
+  methods.push(`protected override set(type: XmlEventTypeValue, preserveTextMemo = false): XmlEventTypeValue {
+    if (type !== XmlEventType.START_ELEMENT) this.normalizedAttributeValues.length = 0;
+    return super.set(type, preserveTextMemo);
+  }`);
+  methods.push(`protected override releaseRetainedInput(): void {
+    this.normalizedAttributeValues.length = 0;
+    super.releaseRetainedInput();
+  }`);
+  methods.push(`protected override waitForStartTag(kind: string): TokenCursorResult {
+    this.normalizedAttributeValues.length = 0;
+    return super.waitForStartTag(kind);
+  }`);
+}
+if (variant === 'attributes-text') throw new Error('Text specialization requires completed A1 verification.');
+// Import only parent module bindings actually referenced by the generated methods.
+const moduleBindings = new Set();
+for (const n of sf.statements) {
+  if (n.name) moduleBindings.add(n.name.getText(sf));
+  if (ts.isVariableStatement(n)) for (const d of n.declarationList.declarations) moduleBindings.add(d.name.getText(sf));
+}
+const needed = new Set(['TokenCursor']);
+const methodSource = ts.createSourceFile('generated.ts', `class X { ${methods.join('\n')} }`, ts.ScriptTarget.Latest, true);
+function collect(n) { if (ts.isIdentifier(n) && moduleBindings.has(n.text)) needed.add(n.text); ts.forEachChild(n, collect); }
+collect(methodSource);
+const imports = [...needed].sort().join(', ');
+const output = `// Generated by scripts/generate-entity-materializing-cursor.mjs; do not edit.\n// variant: ${variant}\n// source-members: ${JSON.stringify(fingerprints)}\nimport { ${imports} } from '../TokenCursor.js';\nimport { XmlEventType, type XmlEventType as XmlEventTypeValue } from '../types.js';\n${variant === 'wiring' ? '' : "import { validateAndNormalizeAttributeSpan } from './entity-normalizer.js';\n"}export class MaterializingTokenCursor extends TokenCursor {\n${variant === 'wiring' ? '' : 'private readonly normalizedAttributeValues: Array<string | undefined> = [];\n'}${methods.join('\n\n')}\n}\n`;
+if (check) {
+  if (readFileSync(outputPath, 'utf8') !== output) throw new Error('Generated cursor is stale.');
+} else writeFileSync(outputPath, output);
+console.log(`${check ? 'Checked' : 'Generated'} ${variant}`);
