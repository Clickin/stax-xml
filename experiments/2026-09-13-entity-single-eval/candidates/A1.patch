+const materializedRequest = Symbol("materialized-reader-request");
+interface InternalMaterializedRequest<O> {
+  readonly [materializedRequest]: true;
+  readonly options: O;
+}
+
+/** Internal envelope is assignable to the unchanged public constructor type. */
+export function requestMaterialized<O extends object>(options: O): O {
+  return { [materializedRequest]: true, options } as unknown as O;
+}
+
+export function isMaterializedRequest<O extends object>(options: O): options is O & InternalMaterializedRequest<O> {
+  return (options as Partial<InternalMaterializedRequest<O>>)[materializedRequest] === true;
+}
