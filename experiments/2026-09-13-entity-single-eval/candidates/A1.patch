+    const pending = reader.next();
+    await Promise.resolve();
+    expect(pulls).toBe(1);
+    release();
+    await expect(pending).resolves.toMatchObject({
+      value: { type: XmlEventType.END_ELEMENT, name: "root" },
+    });
+  });
+});
