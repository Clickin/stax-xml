+          try {
+            const result = iterator.next();
+            trace?.push(['input.next', 'return', { done: result.done, bytes: result.value?.byteLength }]);
+            return result;
+          } catch (error) {
+            trace?.push(['input.next', 'throw', error?.constructor?.name, error?.message]);
+            throw error;
+          }
+        },
+        return(value) {
