+            trace?.push(['input.return', 'return']);
+            return result;
+          } catch (error) {
+            trace?.push(['input.return', 'throw', error?.constructor?.name, error?.message]);
+            throw error;
+          }
+        },
+      };
+    },
+  };
+}
+
+export function normalizeInput(input, { async = false, chunkSize = 64 * 1024, trace } = {}) {
