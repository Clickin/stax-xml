+        present: true,
+        entries: [...event.attributes].map(([key, attribute]) => [
+          key,
+          Object.fromEntries(['name', 'localName', 'prefix', 'namespaceURI', 'value'].map((field) => [field, [hasOwn(attribute, field), attribute[field]]])),
